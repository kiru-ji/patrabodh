# PatraBodh Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (for cloud inference mode)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Inference mode: "gemini" (cloud) or "ollama" (local/offline)
INFERENCE_MODE=gemini

# Gemma 4 model selection
# Options: gemma-4-e2b-it, gemma-4-e4b-it, gemma-4-12b-it, gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-12b-it

# Ollama model name (for local mode)
OLLAMA_MODEL=gemma4:12b

# Visual token budget for image processing
# Options: 70, 140, 280, 560, 1120
# Higher = better OCR quality but slower inference
# Recommended: 560 for document OCR
TOKEN_BUDGET=560

# Server configuration
HOST=0.0.0.0
PORT=8000

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=10
